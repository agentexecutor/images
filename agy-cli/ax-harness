# ax-launcher (installed from agy-cli/ax-harness): Antigravity CLI (agy)
# launcher for the AX in-container wrapper contract.
#
# TODO: Replace this script with a Go binary.
#
# Inputs provided by the mounted AX runner (see runner/launcher.go in
# github.com/google/ax):
#   AX_GOAL_FILE        path to the task's goal (spec.goal.text)
#   AX_CONFIG_FILE      optional path to spec.config serialized as JSON
#   AX_MCP_CONFIG_FILE  optional path to the Workspace's MCP servers as
#                       {"mcpServers": {...}}; each is registered with
#                       `agy mcp add` before the task runs
#   AX_SESSION_FILE     optional path to spec.sessionId; when non-empty,
#                       ~/.gemini/antigravity-cli is symlinked to
#                       <workspace>/.ax/sessions/<sessionId> so conversation
#                       state survives suspend/resume and follow-up turns resume
#                       with --continue while keeping HOME intact
#   AX_OUTPUT_FILE      optional path the agent's final answer is written to
#                       (<workspace>/.ax/output by default)
#   cwd                 the task's workspace
#
# Optional environment variables:
#   AX_SESSION_DIR       override the durable session directory when
#                        AX_SESSION_FILE is set (default:
#                        <workspace>/.ax/sessions/<sessionId>)
#   AGY_BIN              binary name or path (default: "agy")
#   AX_CA_BUNDLE         CA bundle path (default: /run/ate/egress-trust-bundle/trust-bundle.pem)

set -euo pipefail

goal_file="${AX_GOAL_FILE:?AX_GOAL_FILE is not set; ax-launcher must be started by the AX runner}"
config_file="${AX_CONFIG_FILE:-}"

if [[ ! -s "${goal_file}" ]]; then
  echo "ax-launcher: empty goal in ${goal_file}; set spec.goal.text" >&2
  exit 2
fi

session_file="${AX_SESSION_FILE:-}"
session_id=""
if [[ -n "${session_file}" && -s "${session_file}" ]]; then
  session_id="$(tr -d '\r\n' < "${session_file}")"
fi

export HOME="${HOME:-/root}"

# When a session ID is present, symlink ~/.gemini/antigravity-cli into the
# durable workspace so agy's conversation store survives suspend/resume and is
# shared across turns of the same session, without hiding tool configs under
# HOME (such as ~/.gitconfig, ~/.ssh, or ~/.config/gcloud).
resume_session="false"
if [[ -n "${session_id}" ]]; then
  if [[ ! "${session_id}" =~ ^[A-Za-z0-9._-]+$ || "${session_id}" == "." || "${session_id}" == ".." ]]; then
    echo "ax-launcher: invalid session ID ${session_id:?} in ${session_file}" >&2
    exit 2
  fi
  session_dir="${AX_SESSION_DIR:-${PWD}/.ax/sessions/${session_id}}"
  mkdir -p "${session_dir}" "${HOME}/.gemini"
  agy_data_dir="${HOME}/.gemini/antigravity-cli"
  if [[ "${agy_data_dir}" != "${session_dir}" ]]; then
    if [[ -e "${agy_data_dir}" && ! -L "${agy_data_dir}" ]]; then
      if [[ -d "${agy_data_dir}" ]] && [[ -z "$(ls -A "${session_dir}" 2>/dev/null || true)" ]]; then
        cp -a "${agy_data_dir}/." "${session_dir}/"
      fi
      rm -rf "${agy_data_dir}"
    fi
    ln -sfn "${session_dir}" "${agy_data_dir}"
  fi
  if [[ -d "${session_dir}/conversations" ]] && \
     [[ -n "$(ls -A "${session_dir}/conversations" 2>/dev/null || true)" ]]; then
    resume_session="true"
  fi
fi
export PATH="${PATH}:${HOME}/.local/bin"
export AGY_CLI_DISABLE_AUTO_UPDATE="${AGY_CLI_DISABLE_AUTO_UPDATE:-true}"

ca_bundle="${AX_CA_BUNDLE:-/run/ate/egress-trust-bundle/trust-bundle.pem}"
if [[ -f "${ca_bundle}" ]]; then
  export SSL_CERT_FILE="${SSL_CERT_FILE:-${ca_bundle}}"
  export CURL_CA_BUNDLE="${CURL_CA_BUNDLE:-${ca_bundle}}"
fi

AGY_BIN="${AGY_BIN:-agy}"
if ! command -v "${AGY_BIN}" >/dev/null 2>&1; then
  echo "ax-launcher: ${AGY_BIN} not found on PATH" >&2
  exit 127
fi

# Registers the Workspace's MCP servers. `agy mcp add` adds or updates a
# server, so re-running on resume is idempotent. Each server is emitted as
# NUL-delimited `agy mcp add` args followed by an empty terminator.
mcp_file="${AX_MCP_CONFIG_FILE:-}"
if [[ -n "${mcp_file}" && -s "${mcp_file}" ]]; then
  # Written to a file first so a malformed MCP config fails the task under
  # set -e instead of silently registering nothing.
  mcp_list="$(mktemp)"
  python3 - "${mcp_file}" >"${mcp_list}" <<'PY'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as f:
    servers = (json.load(f) or {}).get("mcpServers") or {}
if not isinstance(servers, dict):
    raise ValueError("mcpServers must be an object")

for name in sorted(servers):
    srv = servers[name] or {}
    kind = srv.get("type") or ("http" if srv.get("url") else "stdio")
    if kind == "http" and srv.get("url"):
        args = ["--type", "http", name, srv["url"]]
    elif kind == "stdio" and srv.get("command"):
        args = ["--type", "stdio", name, "--", srv["command"], *map(str, srv.get("args") or [])]
    else:
        print(f"ax-launcher: skipping MCP server {name!r} with neither url nor command", file=sys.stderr)
        continue
    for item in args + [""]:
        sys.stdout.buffer.write(item.encode("utf-8") + b"\0")
PY
  mapfile -d '' -t mcp_args <"${mcp_list}"
  rm -f "${mcp_list}"
  server=()
  for item in "${mcp_args[@]}"; do
    if [[ -n "${item}" ]]; then
      server+=("${item}")
      continue
    fi
    echo "ax-launcher: registering MCP server ${server[2]}" >&2
    "${AGY_BIN}" mcp add "${server[@]}" >&2
    server=()
  done
fi

# Prints outputFile (empty string when unset), followed by NUL-delimited agy args.
mapfile -d '' -t parsed < <(python3 - "${config_file}" "${goal_file}" "${resume_session}" "${PWD}" <<'PY'
import json
import os
import re
import sys

cfg_path, goal_path, resume_session, cwd = sys.argv[1:5]
cfg = {}
if cfg_path:
    with open(cfg_path, "r", encoding="utf-8") as f:
        raw = f.read().strip()
        if raw:
            cfg = json.loads(raw)
with open(goal_path, "r", encoding="utf-8") as f:
    goal = f.read()


def to_flag(key: str) -> str:
    if not re.match(r"^[a-z][a-z0-9]*([A-Z][a-z0-9]+)*$", key):
        raise ValueError(f"spec.config key {key!r} must be camelCase")
    return "--" + re.sub(r"([A-Z])", lambda m: "-" + m.group(1).lower(), key)


output_file = cfg.pop("outputFile", "") or ""
cfg.pop("prompt", None)

settings = cfg.pop("settings", None) or {}
if not isinstance(settings, dict):
    raise ValueError("spec.config.settings must be an object")
adc = os.environ.get("AGY_ADC_AUTH", "").strip().lower() in ("1", "true", "on")
if os.environ.get("GEMINI_API_KEY") and not adc:
    settings = {"modelProvider": "gemini", **settings}

cfg.setdefault("dangerouslySkipPermissions", True)
cfg.setdefault("addDir", [cwd])
if resume_session == "true" and "continue" not in cfg and "conversation" not in cfg:
    cfg["continue"] = True

out = []
for key in sorted(cfg):
    val = cfg[key]
    flag = to_flag(key)
    if isinstance(val, bool):
        out.append(flag if val else f"{flag}=false")
    elif isinstance(val, list):
        for elem in val:
            if isinstance(elem, (dict, list, bool)) or elem is None:
                raise ValueError(
                    f"spec.config.{key}: list elements must be strings or numbers"
                )
            out.append(f"{flag}={elem}")
    elif isinstance(val, dict):
        out.append(f"{flag}={json.dumps(val, separators=(',', ':'))}")
    elif isinstance(val, (str, int, float)):
        out.append(f"{flag}={val}")
    elif val is not None:
        raise ValueError(f"spec.config.{key}: unsupported value {val!r}")

if settings:
    out.append(f"--settings={json.dumps(settings, separators=(',', ':'))}")
out.append(f"--print={goal}")

for item in [output_file] + out:
    sys.stdout.buffer.write(item.encode("utf-8") + b"\0")
PY
)
wait "$!"

agy_args=("${parsed[@]:1}")

# The answer goes to stdout (logs), to AX_OUTPUT_FILE for AX, and to
# spec.config.outputFile when set. Write via per-PID temp files and rename on
# exit so callers polling AX_OUTPUT_FILE never read a partial answer.
outputs=()
tmp_outputs=()
for f in "${AX_OUTPUT_FILE:-}" "${parsed[0]}"; do
  if [[ -z "${f}" ]]; then
    continue
  fi
  dup=false
  for existing in "${outputs[@]:-}"; do
    if [[ "${existing}" == "${f}" ]]; then
      dup=true
      break
    fi
  done
  if [[ "${dup}" == "true" ]]; then
    continue
  fi
  mkdir -p "$(dirname "${f}")"
  # Remove any stale temp outputs left behind if an earlier run was killed mid-turn.
  rm -f -- "${f}.tmp."*
  outputs+=("${f}")
  tmp_outputs+=("${f}.tmp.$$")
done

if [[ "${#outputs[@]}" -eq 0 ]]; then
  exec "${AGY_BIN}" "${agy_args[@]}"
fi

set +e
"${AGY_BIN}" "${agy_args[@]}" | tee "${tmp_outputs[@]}"
status="${PIPESTATUS[0]}"
set -e
for i in "${!outputs[@]}"; do
  mv -f "${tmp_outputs[$i]}" "${outputs[$i]}"
done
exit "${status}"
